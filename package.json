{
  "name": "@cuongtran001/kanna",
  "type": "module",
  "version": "1.44.1",
  "description": "A beautiful web UI for Claude Code",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "chat",
    "ui",
    "agent",
    "anthropic",
    "bun",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuongtranba/kanna.git"
  },
  "bin": {
    "kanna": "./bin/kanna"
  },
  "packageManager": "bun@1.3.11",
  "files": [
    "bin/",
    "src/server/",
    "src/shared/",
    "dist/client/"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "build": "bun run build:client",
    "build:client": "vite build",
    "typecheck": "node_modules/typescript-7/bin/tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run build:client && bun run check:bundle",
    "check:bundle": "bun run ./scripts/check-client-bundle.ts",
    "lint": "eslint src/ --max-warnings=0",
    "lint:usestate": "ast-grep scan --report-style short",
    "check:arch": "bun test --conditions production src/ops/architecture/",
    "lint:limits": "bun run ./scripts/check-complexity-limits.ts",
    "dev": "bun run ./scripts/dev.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5174",
    "dev:server": "bun run ./scripts/dev-server.ts --no-open --port 5175",
    "install:dev": "bun install && bun run build && bun install -g .",
    "start": "bun run ./src/server/cli.ts",
    "test": "bun test --conditions production --timeout 30000",
    "test:e2e": "bun run build && playwright test -c e2e/playwright.config.ts",
    "test:smoke": "playwright test -c e2e/playwright.config.ts e2e/smoke.pw.ts",
    "verify:client-arch": "bunx ast-grep scan && bun run lint && bun run typecheck && bun run test",
    "scan:secrets": "gitleaks dir --no-banner --redact",
    "setup:hooks": "git config core.hooksPath .githooks",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "@atlaskit/pragmatic-drag-and-drop": "3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "2.2.0",
    "@legendapp/list": "3.3.9",
    "@lexical/clipboard": "^0.49.0",
    "@lexical/code": "^0.49.0",
    "@lexical/headless": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/markdown": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/table": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@pierre/diffs": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-query": "^5.101.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "cloudflared": "^0.7.1",
    "cron": "^4.4.0",
    "default-shell": "^2.2.0",
    "file-type": "^22.0.0",
    "fractional-indexing": "4.0.0",
    "lexical": "^0.49.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mermaid": "^11.15.0",
    "micromark-extension-gfm": "^3.0.0",
    "minimatch": "^10.2.5",
    "openai": "^7.8.0",
    "react-resizable-panels": "^4.7.3",
    "react-use-websocket": "^4.13.0",
    "shell-quote": "^1.8.3",
    "sonner": "^2.0.7",
    "uqr": "^0.1.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "latest",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/shell-quote": "^1.7.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "lucide-react": "^1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.12.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.2.2",
    "zustand": "^5.0.10"
  }
}
